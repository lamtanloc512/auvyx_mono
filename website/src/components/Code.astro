---
import { highlight } from "../lib/highlight";

const samples = [
  {
    id: "ts", label: "TypeScript",
    code: `// Fetch a user and cache the result
export async function getUser(id: string): Promise<User | null> {
  const cached = cache.get(id);
  if (cached !== undefined) return cached;

  const res = await fetch(\`/api/users/\${id}\`);
  if (!res.ok) throw new Error("Request failed: " + res.status);

  const user = (await res.json()) as User;
  cache.set(id, user);
  return user ?? null;
}`,
  },
  {
    id: "py", label: "Python",
    code: `# Count words, ignoring case and punctuation
from collections import Counter
import re

def top_words(text: str, n: int = 10) -> list[tuple[str, int]]:
    words = re.findall(r"[\\w']+", text.lower())
    counts = Counter(w for w in words if len(w) >= 3)
    return counts.most_common(n)

if __name__ == "__main__":
    print(top_words(open("book.txt").read()))`,
  },
  {
    id: "rs", label: "Rust",
    code: `// A tiny state machine
#[derive(Debug, Clone, Copy, PartialEq)]
enum Light { Red, Yellow, Green }

impl Light {
    fn next(self) -> Light {
        match self {
            Light::Red => Light::Green,
            Light::Green => Light::Yellow,
            Light::Yellow => Light::Red,
        }
    }
}

fn main() {
    let mut light = Light::Red;
    for _ in 0..4 { light = light.next(); }
    println!("{:?}", light);
}`,
  },
  {
    id: "go", label: "Go",
    code: `// Fan out work to a pool of goroutines
func process(jobs <-chan Job, results chan<- Result) {
	for job := range jobs {
		res, err := job.Run()
		if err != nil {
			log.Printf("job %d failed: %v", job.ID, err)
			continue
		}
		results <- res
	}
}`,
  },
] as const;
---
<section class="code">
  <div class="wrap">
    <p class="eyebrow">In the editor</p>
    <h2>Made for long sessions.</h2>
    <p class="lead">Tuned spacing, generous counters and clear punctuation keep dense code readable at small sizes — in any language.</p>

    <div class="editor card" data-code-theme="auto">
      <div class="editor-head">
        <span>Editor preview</span>
        <label for="code-theme">Code theme
          <select id="code-theme" data-code-theme-control>
            <option value="auto">Match site</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
      </div>
      <div class="tabs" role="tablist" aria-label="Language">
        {samples.map((s, i) => (
          <button role="tab" type="button" class="tab" id={`tab-${s.id}`} aria-controls={`pane-${s.id}`} aria-selected={i === 0 ? "true" : "false"}>{s.label}</button>
        ))}
      </div>
      {samples.map((s, i) => (
        <pre role="tabpanel" id={`pane-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}><code set:html={highlight(s.code, s.id)} /></pre>
      ))}
    </div>
  </div>
</section>

<script>
  const themeControls = document.querySelectorAll<HTMLSelectElement>("[data-code-theme-control]");
  const themedPanels = document.querySelectorAll<HTMLElement>("[data-code-theme]");
  function setCodeTheme(value: string) {
    if (value !== "auto" && value !== "light" && value !== "dark") return;
    themeControls.forEach((control) => (control.value = value));
    themedPanels.forEach((panel) => (panel.dataset.codeTheme = value));
  }
  try { setCodeTheme(localStorage.getItem("code-theme") ?? "auto"); } catch {}
  themeControls.forEach((control) => control.addEventListener("change", () => {
    setCodeTheme(control.value);
    try { localStorage.setItem("code-theme", control.value); } catch {}
  }));

  const tabs = [...document.querySelectorAll<HTMLButtonElement>(".editor .tab")];
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      tabs.forEach((x) => {
        x.setAttribute("aria-selected", String(x === t));
        document.getElementById(x.getAttribute("aria-controls")!)!.hidden = x !== t;
      });
    })
  );
</script>

<style>
  .editor {
    --code-bg: var(--card); --code-fg: var(--fg); --code-muted: var(--muted);
    --code-line: var(--line); --code-active: var(--bg-2);
    --code-comment: var(--tok-com); --code-keyword: var(--tok-kw);
    --code-function: var(--tok-fn); --code-string: var(--tok-str);
    --code-number: var(--tok-num); --code-type: var(--tok-type);
    margin-top: 40px; overflow: hidden; background: var(--code-bg); color: var(--code-fg);
  }
  .editor[data-code-theme="light"] {
    --code-bg: #fff; --code-fg: #161616; --code-muted: #525252;
    --code-line: #e0e0e0; --code-active: #f4f4f4;
    --code-comment: #787878; --code-keyword: #b8326b;
    --code-function: #2c63d6; --code-string: #2f7d4f;
    --code-number: #a55300; --code-type: #7a44c4;
  }
  .editor[data-code-theme="dark"] {
    --code-bg: #161616; --code-fg: #f7f7f7; --code-muted: #b8b8b8;
    --code-line: #3b3b3b; --code-active: #303030;
    --code-comment: #a0a0a0; --code-keyword: #ff79b0;
    --code-function: #7aa2ff; --code-string: #8bd5a0;
    --code-number: #ffb86b; --code-type: #c3a0ff;
  }
  .editor-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--code-line); color: var(--code-muted); font-size: 12px; }
  .editor-head label { display: flex; align-items: center; gap: 10px; }
  .editor-head select { padding: 7px 10px; border: 1px solid var(--code-line); border-radius: 0; background: var(--code-bg); color: var(--code-fg); font-size: 13px; cursor: pointer; }
  .tabs { display: flex; gap: 4px; padding: 10px; border-bottom: 1px solid var(--code-line); overflow-x: auto; }
  .tab {
    font: inherit; font-size: 13px; padding: 8px 14px; border-radius: 0; border: 0;
    background: transparent; color: var(--code-muted); cursor: pointer;
  }
  .tab[aria-selected="true"] { background: var(--code-active); color: var(--code-fg); }
  pre { margin: 0; padding: 24px; font-family: var(--font-mono); font-size: clamp(13px, 1.4vw, 16px); line-height: 1.7; overflow-x: auto; tab-size: 4; color: var(--code-fg); }
  @media (max-width: 520px) {
    .editor-head { flex-wrap: wrap; }
    pre { padding: 16px; }
  }
  pre :global(.c) { color: var(--code-comment); font-style: italic; }
  pre :global(.k) { color: var(--code-keyword); }
  pre :global(.f) { color: var(--code-function); }
  pre :global(.s) { color: var(--code-string); }
  pre :global(.n) { color: var(--code-number); }
  pre :global(.t) { color: var(--code-type); }
</style>
