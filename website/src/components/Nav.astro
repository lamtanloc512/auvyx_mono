---
import { SITE, withBase } from "../config";
const links = [
  ["Try it", "#tester"],
  ["Features", "#features"],
  ["Glyphs", "#glyphs"],
  ["Install", "#install"],
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="logo" href={withBase()} aria-label="Auvyx Mono home">
      <img class="logo-mark" src={withBase("brand/auvyx-mark.svg")} alt="" width="36" height="36" />
      <span class="logo-name"><strong>AUVYX</strong><span> / MONO</span></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-actions">
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"/></svg>
      </button>
      <a class="gh" href={SITE.repo} aria-label="Auvyx Mono on GitHub" title="GitHub" rel="noopener">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      </a>
      <a class="btn nav-cta" href={SITE.download} download>Download</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; gap: 24px; min-height: 68px; }
  .logo { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; text-decoration: none; white-space: nowrap; }
  .logo:hover { color: var(--fg); }
  .logo-mark { display: block; width: 36px; height: 36px; }
  .logo-name { font: 500 14px/1 var(--font-mono); letter-spacing: -.04em; }
  .logo-name strong { font-weight: 700; }
  .logo-name span { color: var(--muted); }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 22px; list-style: none; margin: 0; padding: 0; font-size: 14px; white-space: nowrap; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--fg); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .theme-toggle {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px;
    border: 1px solid var(--line); background: transparent; color: var(--fg); cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--fg); }
  .gh { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px; border: 1px solid var(--line); color: var(--fg); }
  .gh:hover { border-color: var(--fg); color: var(--fg); }
  :global([data-theme="dark"]) .sun { display: none; }
  :global([data-theme="light"]) .moon { display: none; }
  .nav-cta { min-height: 44px; padding: 9px 16px; font-size: 14px; }
  @media (max-width: 900px) {
    .nav-inner { flex-wrap: wrap; gap: 0; padding-top: 10px; }
    .logo { margin-right: auto; }
    nav { order: 3; width: 100%; margin: 8px 0 0; overflow-x: auto; scrollbar-width: none; }
    nav::-webkit-scrollbar { display: none; }
    nav ul { gap: 24px; }
    nav a { display: block; padding: 13px 0 14px; }
  }
  @media (max-width: 480px) {
    .nav-actions { gap: 6px; }
    .gh { display: none; }
    .nav-cta { padding: 9px 12px; }
    .theme-toggle { width: 40px; height: 44px; }
    .logo-name { font-size: 13px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
  btn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
  });
</script>
