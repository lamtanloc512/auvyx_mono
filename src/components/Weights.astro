---
const weights = [
  [100, "Thin"], [200, "ExtraLight"], [300, "Light"], [400, "Regular"],
  [500, "Medium"], [600, "SemiBold"], [700, "Bold"],
];
---
<section id="features" class="weights">
  <div class="wrap">
    <p class="eyebrow">Weights <code>wght 100–700</code></p>
    <h2>Thin to Bold. And everything in between.</h2>
    <p class="lead">Seven named instances plus a variable font with a continuous weight axis. Pick a hairline for big titles or a heavy weight for low-contrast screens.</p>
    <ul class="ladder">
      {weights.map(([w, name]) => (
        <li style={`font-weight:${w}`}>
          <span class="meta"><b>{w}</b> {name}</span>
          <span class="sample">Hamburgefonstiv 0123</span>
          <span class="sample it">Hamburgefonstiv</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ladder { list-style: none; margin: 44px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .ladder li {
    display: grid; grid-template-columns: 170px 1fr auto; align-items: baseline; gap: 24px;
    padding: 14px 0; border-bottom: 1px solid var(--line);
    font-size: clamp(22px, 3.6vw, 44px); line-height: 1.2;
    white-space: nowrap; overflow: hidden;
  }
  .meta { font-size: 13px; font-weight: 400; color: var(--muted); }
  .meta b { color: var(--fg); font-weight: 600; margin-right: 6px; }
  .sample { overflow: hidden; text-overflow: ellipsis; }
  .it { font-style: italic; color: var(--muted); }
  @media (max-width: 860px) {
    .ladder li { grid-template-columns: 110px 1fr; }
    .it { display: none; }
  }
</style>
