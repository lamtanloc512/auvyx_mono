---
const samples = [
  ["Tiếng Việt", "Người ta thường nói: công cụ tốt giúp ta làm việc nhanh hơn, còn công cụ đẹp khiến ta muốn làm việc lâu hơn."],
  ["English", "Good tools help you work faster; beautiful tools make you want to keep working."],
  ["Français", "Les bons outils font gagner du temps ; les beaux outils donnent envie de continuer."],
  ["Deutsch", "Gute Werkzeuge machen dich schneller; schöne Werkzeuge lassen dich gerne weitermachen."],
  ["Polski", "Dobre narzędzia przyspieszają pracę; piękne sprawiają, że chce się pracować dłużej."],
  ["Ελληνικά", "Τα καλά εργαλεία σε κάνουν γρηγορότερο· τα όμορφα σε κάνουν να θέλεις να συνεχίσεις."],
  ["Русский", "Хорошие инструменты ускоряют работу, а красивые — вдохновляют работать дольше."],
];
---
<section class="langs">
  <div class="wrap">
    <p class="eyebrow">Languages</p>
    <h2>Speaks your language. Especially Vietnamese.</h2>
    <p class="lead">
      Latin, Greek and Cyrillic, with carefully stacked diacritics for
      Vietnamese — <span lang="vi">ơ ư ợ ữ ặ ẫ ỷ</span> sit comfortably
      without crashing into the line above.
    </p>
    <dl class="lang-list">
      {samples.map(([name, text]) => (
        <div>
          <dt>{name}</dt>
          <dd lang={name === "Tiếng Việt" ? "vi" : undefined}>{text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .lang-list { margin: 40px 0 0; border-top: 1px solid var(--line); }
  .lang-list div { display: grid; grid-template-columns: 160px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; color: var(--muted); padding-top: 6px; }
  dd { margin: 0; font-size: clamp(18px, 2.2vw, 26px); line-height: 1.5; }
  .lang-list div:first-child dd { font-size: clamp(22px, 3vw, 36px); }
  @media (max-width: 640px) { .lang-list div { grid-template-columns: 1fr; gap: 4px; } }
</style>
